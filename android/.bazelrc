build --tool_java_language_version=17
build --java_language_version=17
build --java_runtime_version=17
build --tool_java_runtime_version=17
build --platforms=//:arm64-v8a

# https://bazel.build/external/migration
common --enable_bzlmod --local_resources=cpu=HOST_CPUS-1

# Para usar bazel build --config=android
# Passando os defines como --cxxopt=-D pq o define da linha de comando parece conflitar com defines aqui.
build:android --android_platforms=//:arm64-v8a --cxxopt=-DBENCHMARK=0 --cxxopt=-DUSAR_OPENGL_ES=1 --cxxopt=-DANDROID=1 --cxxopt=-std=c++20 --cxxopt=-Wno-deprecated-declarations --cxxopt=-Wno-unused-lambda-capture
